# Agent Club settings. Copy to .env.local and fill in what you use; leave the rest empty.
# The server re-reads .env.local on every poll. Never commit .env.local.

# n8n (Settings -> n8n API in your n8n instance)
N8N_URL=
N8N_API_KEY=

# LangGraph runs via Langfuse (e.g. https://cloud.langfuse.com)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# name shown in the club, e.g. "myapp" gives "myapp · run 8f2c"
LANGFUSE_PREFIX=

# OpenRouter (shows key limit and account balance)
OPENROUTER_API_KEY=

# Ollama (local models; comma-separated model names, e.g. llama3.2:3b)
OLLAMA_URL=
OLLAMA_MODELS=

# Infra health board (used by infra.example.json; see README)
SITE_URL=
API_HEALTH_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_HEALTH_TABLE=
